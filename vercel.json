{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",

  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "cookie", "key": "language", "value": "es" }],
      "destination": "/es",
      "permanent": false
    },
    {
      "source": "/",
      "missing": [{ "type": "cookie", "key": "language" }],
      "has": [{ "type": "header", "key": "accept-language", "value": "^(es|ES).*" }],
      "destination": "/es",
      "permanent": false
    },
    {
      "source": "/test-maker/:path*",
      "destination": "https://test-maker.pablodiazjorge.com/:path*",
      "permanent": true
    },
    {
      "source": "/palaze/:path*",
      "destination": "https://palaze.pablodiazjorge.com/:path*",
      "permanent": true
    },
    {
      "source": "/attention-matrix-explorer/:path*",
      "destination": "https://attention-matrix-explorer.pablodiazjorge.com/:path*",
      "permanent": true
    },
    {
      "source": "/token-cost-analyzer/:path*",
      "destination": "https://token-cost-analyzer.pablodiazjorge.com/:path*",
      "permanent": true
    },
    {
      "source": "/candle-ai/:path*",
      "destination": "https://candle-ai.pablodiazjorge.com/:path*",
      "permanent": true
    }
  ],

  "rewrites": [
    { "source": "/es", "destination": "/es/index.html" }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}